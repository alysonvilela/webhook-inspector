# Project
COMPOSE_PROJECT_NAME=webhook-inspector

# Database
DB_USER=docker
DB_PASSWORD=your-db-password-here
DB_NAME=webhooks
DB_PORT=5498
DATABASE_URL=postgresql://docker:password@postgres:5432/webhooks

# Backend API
BACKEND_PORT=3333
NODE_ENV=development

# Frontend Web
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3333
VITE_PUBLIC_URL=http://localhost:5173

# External Services (optional)
# GOOGLE_GENERATIVE_AI_API_KEY=your-key-here